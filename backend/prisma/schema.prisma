// =============================================================================
// LANGKAH 1 — SKEMA DATABASE (Prisma + PostgreSQL)
// -----------------------------------------------------------------------------
// Alur data:
//   Webhook pesan masuk  -> Lead (perusahaan) + ChatSession (status ai_qualifying)
//   AI Agent (Claude)    -> menentukan segmen (B2B/B2C) + lini produk Ichiban,
//                           mengisi data Lead + ringkasan
//   Routing Round Robin  -> AgentSkill (lini produk x segmen) -> ChatSession.assignedAgentId
//                           + User.lastAssignedAt
//   Dashboard Sales      -> membaca ChatSession + Message milik agent tersebut
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUM
// -----------------------------------------------------------------------------

/// Segmen customer. Menentukan data apa yang dikualifikasi AI dan tim mana yang menangani.
/// - B2B: perusahaan/kontraktor/pabrik/galangan/percetakan (pembelian volume, proyek).
/// - B2C: konsumen perorangan / pembeli eceran (rumah, renovasi, hobi).
enum CustomerType {
  B2B
  B2C
}

/// Peran pengguna internal CRM.
enum UserRole {
  ADMIN
  SALES_MANAGER
  SALES_AGENT
}

/// Status sesi chat.
/// - ai_qualifying      : AI Agent masih menanyai calon customer.
/// - pending_assignment : kualifikasi selesai, tetapi belum ada sales yang tersedia
///                        (antrean; akan di-assign ulang oleh job/admin).
/// - assigned_to_human  : sesi sudah dipegang Sales Agent, AI berhenti total.
/// - closed             : sesi ditutup.
enum ChatSessionStatus {
  ai_qualifying
  pending_assignment
  assigned_to_human
  closed
}

/// Tahapan pipeline penjualan untuk Lead (ditampilkan di sidebar kanan dashboard).
enum PipelineStage {
  NEW
  CONTACTED
  PROPOSAL
  CLOSED
}

/// Pengirim sebuah pesan.
enum MessageSender {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

// -----------------------------------------------------------------------------
// MODEL
// -----------------------------------------------------------------------------

/// User/Agent internal. Sales Agent memiliki daftar skill industri.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  role           UserRole  @default(SALES_AGENT)
  /// Agent non-aktif (cuti/resign) tidak ikut rotasi round robin.
  isActive       Boolean   @default(true)
  /// Kunci algoritma Round Robin: agent dengan nilai paling lama (atau NULL =
  /// belum pernah menerima lead) dipilih lebih dulu.
  lastAssignedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// Spesialisasi agent: kombinasi lini produk x segmen (lihat AgentSkill).
  skills           AgentSkill[]
  ownedAccounts    Account[]       @relation("AccountOwner")
  ownedContacts    Contact[]       @relation("ContactOwner")
  ownedDeals       Deal[]          @relation("DealOwner")
  activities       Activity[]      @relation("ActivityAuthor")
  assignedTasks    Task[]          @relation("TaskAssignee")
  createdTasks     Task[]          @relation("TaskCreator")
  quotations       Quotation[]     @relation("QuotationCreator")
  assignedTickets  Ticket[]        @relation("TicketAssignee")
  createdTickets   Ticket[]        @relation("TicketCreator")
  ticketComments   TicketComment[] @relation("TicketCommentAuthor")
  assignedSessions ChatSession[]   @relation("AssignedAgent")
  sentMessages     Message[]       @relation("MessageAuthor")

  // Index untuk query routing: filter role+isActive lalu urutkan lastAssignedAt.
  @@index([role, isActive, lastAssignedAt])
  @@map("users")
}

/// Katalog lini produk Ichiban / PT Warnatama Cemerlang. Disimpan di database
/// (bukan enum) supaya admin bisa menambah lini produk baru tanpa deploy ulang;
/// prompt & skema JSON AI dibangun dinamis dari tabel ini.
model ProductLine {
  id          String         @id @default(cuid())
  /// Kode stabil yang dipakai AI & routing, mis. "MARINE_PAINT".
  code        String         @unique
  /// Nama tampilan, mis. "Ichiban Marine Paint".
  name        String
  /// Deskripsi singkat untuk membantu AI mengenali lini produk dari pertanyaan customer.
  description String
  /// Fakta resmi yang BOLEH disampaikan AI ke customer (diisi tim marketing).
  /// AI dilarang mengarang spesifikasi/harga di luar teks ini.
  aiKnowledge String?
  /// Segmen yang dilayani lini produk ini.
  segments    CustomerType[]
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  agentSkills AgentSkill[]
  leads       Lead[]
  deals       Deal[]
  tickets     Ticket[]

  @@map("product_lines")
}

/// Skill agent = (lini produk, segmen). Contoh: Citra menangani
/// (MARINE_PAINT, B2B) dan (INDUSTRIAL_PAINT, B2B); tim retail menangani (RETAIL_PAINT, B2C).
model AgentSkill {
  agentId       String
  productLineId String
  customerType  CustomerType

  agent       User        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  productLine ProductLine @relation(fields: [productLineId], references: [id], onDelete: Cascade)

  @@id([agentId, productLineId, customerType])
  // Index utama query routing: "siapa saja yang bisa menangani lini X segmen Y?"
  @@index([productLineId, customerType])
  @@map("agent_skills")
}

/// Lead = calon customer, perusahaan (B2B) maupun perorangan (B2C).
model Lead {
  id             String        @id @default(cuid())
  /// ID eksternal dari channel (mis. nomor WhatsApp / ID widget chat).
  externalId     String        @unique
  customerType   CustomerType?
  productLineId  String?
  /// Nama orang yang chat (B2C: customer itu sendiri; B2B: PIC perusahaan).
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  /// Kota/lokasi: penting untuk B2C (rujukan toko/dealer terdekat) & ongkos kirim B2B.
  city           String?
  // --- khusus B2B ---
  companyName    String?
  /// Skala perusahaan hasil kualifikasi (mis. "UMKM <50 karyawan", "Enterprise").
  companyScale   String?
  /// Bidang usaha customer B2B, mis. "Galangan kapal", "Percetakan kemasan".
  businessSector String?
  /// Rangkuman kebutuhan dari AI, ditampilkan di "AI Summary Box".
  aiSummary      String?
  pipelineStage  PipelineStage @default(NEW)
  /// Terisi setelah lead dikonversi menjadi Account/Contact/Deal.
  accountId      String?
  contactId      String?
  convertedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  productLine ProductLine?  @relation(fields: [productLineId], references: [id], onDelete: SetNull)
  account     Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal        Deal?
  sessions    ChatSession[]

  @@index([customerType, productLineId])
  @@index([pipelineStage])
  @@map("leads")
}

/// Sesi percakapan antara Lead dan (AI -> Sales Agent).
model ChatSession {
  id              String            @id @default(cuid())
  leadId          String
  status          ChatSessionStatus @default(ai_qualifying)
  assignedAgentId String?
  assignedAt      DateTime?
  qualifiedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedAgent User?     @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages      Message[]

  // Dashboard sales: "semua sesi milik agent X, urut terbaru".
  @@index([assignedAgentId, status, updatedAt])
  @@index([leadId, status])
  @@map("chat_sessions")
}

/// Satu pesan di dalam sesi chat.
model Message {
  id        String        @id @default(cuid())
  sessionId String
  sender    MessageSender
  /// Diisi bila sender = AGENT (siapa sales yang membalas).
  authorId  String?
  content   String
  createdAt DateTime      @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User?       @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("messages")
}

// =============================================================================
// MODUL SALES (CRM Operasional)
// -----------------------------------------------------------------------------
// Lead (hasil chat) -> dikonversi menjadi Account (perusahaan, B2B) + Contact
// (orang) + Deal (peluang penjualan). Deal bergerak di pipeline, dilengkapi
// Activity (log interaksi), Task (tindak lanjut), dan Quotation (penawaran).
// =============================================================================

enum DealStage {
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  WHATSAPP
  VISIT
  NOTE
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Perusahaan/organisasi customer (B2B). Customer B2C cukup berupa Contact tanpa Account.
model Account {
  id             String       @id @default(cuid())
  name           String
  customerType   CustomerType @default(B2B)
  businessSector String?
  scale          String?
  city           String?
  address        String?
  phone          String?
  email          String?
  /// NPWP untuk kebutuhan faktur pajak B2B.
  taxId          String?
  ownerId        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner      User        @relation("AccountOwner", fields: [ownerId], references: [id])
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  quotations Quotation[]
  leads      Lead[]
  tickets    Ticket[]

  @@index([ownerId])
  @@index([name])
  @@map("accounts")
}

/// Orang: PIC perusahaan (B2B) atau customer perorangan (B2C).
model Contact {
  id        String   @id @default(cuid())
  accountId String?
  name      String
  jobTitle  String?
  phone     String?
  email     String?
  city      String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account    Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  owner      User       @relation("ContactOwner", fields: [ownerId], references: [id])
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  leads      Lead[]
  tickets    Ticket[]

  @@index([ownerId])
  @@index([accountId])
  @@index([phone])
  @@map("contacts")
}

/// Peluang penjualan. Nilai uang memakai Decimal (bukan float) agar tidak ada galat pembulatan.
model Deal {
  id                String       @id @default(cuid())
  title             String
  customerType      CustomerType
  stage             DealStage    @default(QUALIFICATION)
  amount            Decimal      @default(0) @db.Decimal(18, 2)
  currency          String       @default("IDR")
  /// Peluang menang (0-100). Default mengikuti stage, bisa diubah manual.
  probability       Int          @default(10)
  expectedCloseDate DateTime?
  lostReason        String?
  stageChangedAt    DateTime     @default(now())
  closedAt          DateTime?
  accountId         String?
  contactId         String?
  leadId            String?      @unique
  productLineId     String?
  ownerId           String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  productLine ProductLine? @relation(fields: [productLineId], references: [id], onDelete: SetNull)
  owner       User         @relation("DealOwner", fields: [ownerId], references: [id])
  activities  Activity[]
  tasks       Task[]
  quotations  Quotation[]
  tickets     Ticket[]

  @@index([ownerId, stage])
  @@index([productLineId, stage])
  @@index([accountId])
  @@map("deals")
}

/// Log interaksi (telepon, meeting, kunjungan, catatan) — membentuk timeline customer.
model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  subject     String
  notes       String?
  occurredAt  DateTime     @default(now())
  durationMin Int?
  authorId    String
  dealId      String?
  accountId   String?
  contactId   String?
  createdAt   DateTime     @default(now())

  author  User     @relation("ActivityAuthor", fields: [authorId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([dealId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([contactId, occurredAt])
  @@map("activities")
}

/// Tugas tindak lanjut dengan tenggat & prioritas.
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  completedAt DateTime?
  assigneeId  String
  createdById String
  dealId      String?
  accountId   String?
  contactId   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignee  User     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User     @relation("TaskCreator", fields: [createdById], references: [id])
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([assigneeId, status, dueAt])
  @@index([dealId])
  @@map("tasks")
}

/// Penawaran harga. Total dihitung di server dari item (tidak dipercaya dari klien).
model Quotation {
  id          String          @id @default(cuid())
  /// Nomor unik berurutan per bulan, mis. "QUO-202610-0007".
  number      String          @unique
  dealId      String
  accountId   String?
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?
  notes       String?
  subtotal    Decimal         @db.Decimal(18, 2)
  discount    Decimal         @default(0) @db.Decimal(18, 2)
  /// Persentase PPN, mis. 11.00.
  taxPercent  Decimal         @default(11) @db.Decimal(5, 2)
  taxAmount   Decimal         @db.Decimal(18, 2)
  total       Decimal         @db.Decimal(18, 2)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  deal      Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  account   Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy User            @relation("QuotationCreator", fields: [createdById], references: [id])
  items     QuotationItem[]

  @@index([dealId])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productName String
  sku         String?
  quantity    Decimal @db.Decimal(18, 3)
  /// Satuan, mis. "pail 20L", "galon", "kg".
  unit        String
  unitPrice   Decimal @db.Decimal(18, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

/// Penghitung atomik (nomor dokumen berurutan) — aman dipakai paralel.
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

// =============================================================================
// MODUL SERVICE (CRM Operasional — layanan purna jual)
// -----------------------------------------------------------------------------
// Tiket keluhan/permintaan bantuan (mis. cat mengelupas, warna tidak sesuai,
// pengiriman terlambat, cara aplikasi) dengan target SLA per prioritas.
// =============================================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  PRODUCT_QUALITY
  DELIVERY
  TECHNICAL_SUPPORT
  WARRANTY_CLAIM
  BILLING
  OTHER
}

model Ticket {
  id                 String         @id @default(cuid())
  /// Nomor unik berurutan per bulan, mis. "TKT-202610-0003".
  number             String         @unique
  subject            String
  description        String
  category           TicketCategory @default(OTHER)
  priority           TicketPriority @default(NORMAL)
  status             TicketStatus   @default(OPEN)
  customerType       CustomerType?
  productLineId      String?
  /// Nomor batch produksi pada kemasan — penting untuk investigasi kualitas.
  batchNumber        String?
  accountId          String?
  contactId          String?
  dealId             String?
  assigneeId         String?
  createdById        String
  /// Target SLA dihitung saat tiket dibuat / prioritas diubah (lihat sla.ts).
  firstResponseDueAt DateTime
  resolutionDueAt    DateTime
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  productLine ProductLine?    @relation(fields: [productLineId], references: [id], onDelete: SetNull)
  account     Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact     Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal        Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("TicketCreator", fields: [createdById], references: [id])
  comments    TicketComment[]

  @@index([assigneeId, status])
  @@index([status, resolutionDueAt])
  @@index([accountId])
  @@index([contactId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  /// true = catatan internal tim (tidak dikirim ke customer).
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketCommentAuthor", fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}
