# Koneksi PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_ichiban?schema=public"
# Kunci API Anthropic (atau gunakan `ant auth login`)
ANTHROPIC_API_KEY="sk-ant-..."
# Model Claude untuk AI Agent kualifikasi
ANTHROPIC_MODEL="claude-opus-5-5"
# Port HTTP + Socket.IO
PORT=4000
# Origin frontend yang diizinkan (CORS + Socket.IO)
CORS_ORIGIN="http://localhost:5173"
# Secret bersama untuk webhook (header X-Webhook-Secret)
WEBHOOK_SECRET="ganti-dengan-secret-acak"
